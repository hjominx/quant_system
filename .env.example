# =================================================================
# 빗썸 안정형 자동매매 시스템 - 환경변수 템플릿
# =================================================================
# 사용법:
#   1. 이 파일을 .env 로 복사하세요:  cp .env.example .env
#   2. .env 의 값들을 실제 값으로 채우세요
#   3. .env 파일은 절대 git에 올리지 마세요 (.gitignore에 등록됨)
# =================================================================

# ----- 빗썸 API 키 (필수) -----
# 빗썸 OpenAPI 페이지에서 발급: https://www.bithumb.com/react/api-support/management-api
# 권한: 자산조회 / 주문조회 / 주문하기 (출금 권한 절대 X)
BITHUMB_API_KEY=your_api_key_here
BITHUMB_SECRET_KEY=your_secret_key_here

# ----- 운영 모드 -----
# DEVELOPMENT: 실거래 차단, 모든 주문이 dry-run (모의 실행)
# PAPER:       실거래 차단, 시뮬레이션 매매 기록
# LIVE:        실거래 활성화 (충분히 검증된 뒤에만 사용)
TRADING_MODE=DEVELOPMENT

# ----- 위험관리 한도 (필수) -----
# 일일 손실 한도 (예: 0.03 = -3%)
DAILY_LOSS_LIMIT=0.03
# 주간 손실 한도 (예: 0.07 = -7%)
WEEKLY_LOSS_LIMIT=0.07
# 누적 MDD 한도 (예: 0.15 = -15%)
MAX_DRAWDOWN_LIMIT=0.15
# 단일 자산 최대 비중 (예: 0.25 = 25%)
MAX_POSITION_PER_COIN=0.25
# 전체 코인 보유 최대 비중 (예: 0.80 = 80%, 현금 최소 20%)
MAX_TOTAL_CRYPTO=0.80

# ----- 초기 자본 (백테스트·실전 공통 기준) -----
INITIAL_CAPITAL=10000000

# ----- 알림 설정 (선택, 추후 사용) -----
# 텔레그램 봇 (https://core.telegram.org/bots#how-do-i-create-a-bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- 로깅 -----
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
