[Unit]
Description=Quant System ETH Cash Live Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/quant_system
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_MODE=LIVE
ExecStart=/home/ubuntu/quant_system/venv/bin/python -B /home/ubuntu/quant_system/scripts/run_eth_cash_micro_live.py --loop --live --yes-i-understand-risk --profile stable_quality --timeframe 4h --profile-mode-file logs/eth_cash_live_profile.json --market-mode-file logs/pulse_market.json --auto-trade-file logs/AUTO_TRADE_ENABLED --force-start-file logs/REBATE_MICRO_FORCE_START.json --turnover-file logs/rebate_micro_turnover.json --turnover-target-krw 100000000000 --max-order-krw 100000 --max-position-krw 200000 --max-orders-per-day 300 --cooldown-seconds 0 --interval-seconds 1 --status-alert-interval-minutes 60 --status-alert-on-hour --no-file-log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
